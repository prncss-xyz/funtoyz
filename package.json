{
	"name": "funtoyz",
	"homepage": "https://github.com/prncss-xyz/funtoyz",
	"private": true,
	"version": "0.0.0",
	"description": "",
	"scripts": {
		"build": "vp run -r build",
		"check": "vp check && vp run -r check:types",
		"check:test": "vp run test:coverage",
		"check:types": "vp run -r check:types",
		"clean": "rm -rf **/{.dist,coverage}",
		"clean-all": "rm -rf **/{node_modules,dist,coverage}",
		"dev:test": "vp test watch",
		"fix:eslint": "vp lint --fix",
		"fix:oxlint": "vp lint --fix",
		"fix:prettier": "vp fmt",
		"fix:sherif": "sherif --fix",
		"fix:style": "vp fmt",
		"lint": "vp check",
		"lint:eslint": "vp lint",
		"lint:oxlint": "vp lint",
		"lint:style": "vp fmt --check",
		"test:cache": "vp run test",
		"verify": "vp run build && vp check && vp run -r check:types && vp run test:coverage && vp run sherif && vp run lint:knip"
	},
	"keywords": [],
	"author": "Juliette Lamarche <juliette.lamarche.xyz@gmail.com> (https://github.com/prncss-xyz/)",
	"license": "MIT",
	"type": "module",
	"devDependencies": {
		"@commitlint/cli": "^20.5.3",
		"@commitlint/config-conventional": "^20.5.3",
		"@commitlint/types": "^20.5.0",
		"@testing-library/react": "^16.3.2",
		"@types/node": "^25.6.2",
		"@vitest/coverage-v8": "^4.1.5",
		"happy-dom": "^20.9.0",
		"knip": "^6.12.1",
		"sherif": "^1.11.1",
		"typescript": "^6.0.3",
		"vite-plus": "catalog:",
		"vitest": "catalog:"
	},
	"packageManager": "pnpm@11.0.9"
}
