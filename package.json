{
	"name": "funtoyz",
	"homepage": "https://github.com/prncss-xyz/funtoyz",
	"private": true,
	"version": "0.0.0",
	"description": "",
	"scripts": {
		"clean": "rm -rf **/{.turbo,dist,coverage}",
		"clean-all": "rm -rf **/{node_modules,.turbo,dist,coverage}",
		"dev": "turbo run dev",
		"verify": "turbo run verify",
		"update": "pnpm update --latest --recursive",
		"knip": "knip --cache",
		"check:test": "vitest run --coverage",
		"dev:test": "vitest",
		"lint:style": "oxfmt --check",
		"sherif": "sherif -r non-existant-packages",
		"lint": "pnpm run lint:style && pnpm run lint:oxlint",
		"lint:oxlint": "oxlint",
		"fix:style": "oxfmt",
		"fix:oxlint": "oxlint --fix",
		"fix:sherif": "pnpm run sherif --fix",
		"prepare": "husky",
		"commitlint": "commitlint --edit"
	},
	"keywords": [],
	"author": "Juliette Lamarche <juliette.lamarche.xyz@gmail.com> (https://github.com/prncss-xyz/)",
	"license": "MIT",
	"packageManager": "pnpm@10.15.1",
	"type": "module",
	"devDependencies": {
		"@commitlint/cli": "^20.5.3",
		"@commitlint/config-conventional": "^20.5.3",
		"@testing-library/react": "^16.3.2",
		"@turbo/gen": "^2.9.9",
		"@types/node": "^25.6.0",
		"@vitest/coverage-v8": "^4.1.5",
		"happy-dom": "^20.9.0",
		"husky": "^9.1.7",
		"knip": "^6.11.0",
		"lint-staged": "^16.4.0",
		"oxfmt": "^0.48.0",
		"oxlint": "^1.63.0",
		"sherif": "^1.11.1",
		"turbo": "^2.9.9",
		"typescript": "^6.0.3",
		"vitest": "^4.1.5"
	}
}
