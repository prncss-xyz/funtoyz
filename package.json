{
	"name": "funtoyz",
	"homepage": "https://github.com/prncss-xyz/funtoyz",
	"private": true,
	"version": "0.0.0",
	"description": "",
	"scripts": {
		"clean": "rm -rf **/{.dist,coverage}",
		"clean-all": "rm -rf **/{node_modules,dist,coverage}",
		"knip": "knip --cache",
		"check:test": "vp test run --coverage",
		"dev:test": "vp test",
		"lint:style": "vp fmt --check",
		"sherif": "sherif -r non-existant-packages",
		"lint:oxlint": "vp lint",
		"fix:style": "vp fmt",
		"fix:oxlint": "vp lint --fix",
		"fix:sherif": "sherif --fix",
		"prepare": "husky",
		"commitlint": "commitlint --edit"
	},
	"keywords": [],
	"author": "Juliette Lamarche <juliette.lamarche.xyz@gmail.com> (https://github.com/prncss-xyz/)",
	"license": "MIT",
	"packageManager": "pnpm@10.15.1",
	"type": "module",
	"devDependencies": {
		"@commitlint/cli": "^20.5.3",
		"@commitlint/config-conventional": "^20.5.3",
		"@commitlint/types": "^20.5.0",
		"@testing-library/react": "^16.3.2",
		"@types/node": "^25.6.2",
		"@vitest/coverage-v8": "^4.1.5",
		"happy-dom": "^20.9.0",
		"husky": "^9.1.7",
		"knip": "^6.12.1",
		"lint-staged": "^17.0.2",
		"sherif": "^1.11.1",
		"typescript": "^6.0.3",
		"vite-plus": "catalog:",
		"vitest": "catalog:"
	}
