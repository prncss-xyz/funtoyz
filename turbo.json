{
	"$schema": "https://turborepo.com/schema.json",
	"tasks": {
		"build": {
			"outputs": ["dist/**"],
			"env": ["BASE_PATH"],
			"dependsOn": ["^build"]
		},
		"//#check:test": {
			"dependsOn": ["^build"],
			"outputs": ["coverage/**"]
		},
		"check:types": {
			"dependsOn": ["build"]
		},
		"check": {
			"dependsOn": ["check:types", "//#check:test"]
		},
		"//#lint:style": {},
		"verify": {
			"dependsOn": ["check"]
		},
		"dev": {
			"persistent": true,
			"cache": false
		}
	}
}
